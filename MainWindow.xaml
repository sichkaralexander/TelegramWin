<Window x:Class="TelegramWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TelegramWin" Height="360" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <!-- Live region для JAWS -->
        <TextBlock x:Name="LiveStatus"
                   Opacity="0.01"
                   Height="1"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{Binding StatusText}" />

        <StackPanel>
            <TextBlock Text="TelegramWin" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="Сейчас используется окно входа. Это окно временно оставлено для совместимости проекта."/>
            <Button Margin="0,16,0,0" Content="Открыть окно входа" Click="OpenLogin_Click"
                    AutomationProperties.Name="Открыть окно входа"/>
        </StackPanel>
    </Grid>
</Window>
