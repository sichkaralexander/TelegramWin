<Window x:Class="TelegramWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TelegramWin"
        Height="400"
        Width="450"
        Background="#111111"
        Foreground="White">

    <StackPanel Margin="20">

        <TextBlock Text="Вход в Telegram"
                   FontSize="20"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Номер телефона"/>
        <TextBox x:Name="PhoneBox"
                 Text="+7"
                 Margin="0,5,0,10"
                 Height="30"/>

        <Button Content="Отправить код"
                Height="35"
                Margin="0,0,0,15"
                Click="SendCode_Click"/>

        <TextBlock Text="Код подтверждения"/>
        <TextBox x:Name="CodeBox"
                 Margin="0,5,0,10"
                 Height="30"/>

        <Button Content="Подтвердить код"
                Height="35"
                Margin="0,0,0,15"
                Click="ConfirmCode_Click"/>

        <TextBlock x:Name="StatusText"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>
    </StackPanel>

</Window>
