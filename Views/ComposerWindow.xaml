<Window x:Class="TelegramWin.Views.ComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Написать сообщение"
        Height="320" Width="520"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel Margin="10" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border BorderThickness="1" Padding="8"
                    Visibility="{Binding IsReplyMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Ответ на:"/>
                    <TextBlock Text="{Binding ReplyPreviewText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBox x:Name="ComposerBox"
                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="160"
                 PreviewKeyDown="ComposerBox_PreviewKeyDown"
                 AutomationProperties.Name="{Binding ComposerAutomationName}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="SendButton"
                    Content="Отправить"
                    MinWidth="110"
                    IsDefault="True"
                    Click="SendButton_Click"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    MinWidth="110"
                    Margin="10,0,0,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>

            <TextBlock Margin="12,4,0,0"
                       Text="Enter — отправить, Shift+Enter — новая строка, Esc — отмена"
                       TextWrapping="Wrap"/>
        </StackPanel>

    </DockPanel>
</Window>