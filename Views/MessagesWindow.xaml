<Window x:Class="TelegramWin.Views.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщения"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>

            <!-- Live region для JAWS: озвучка новых сообщений, НЕ попадает в фокус -->
            <TextBlock x:Name="LiveStatus"
                       Opacity="0.01"
                       Height="1"
                       Focusable="False"
                       IsHitTestVisible="False"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name=""/>

            <!-- Скрываем статус, чтобы JAWS не говорил лишнее при открытии -->
            <TextBlock Text="{Binding Status}"
                       Visibility="Collapsed"
                       Focusable="False"
                       IsHitTestVisible="False"
                       AutomationProperties.Name=""/>
        </StackPanel>

        <ListBox x:Name="MessagesList"
                 Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6,0,6">
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   Focusable="False"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Meta}" Opacity="0.8" Margin="0,2,0,0"
                                   Focusable="False"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Window>
