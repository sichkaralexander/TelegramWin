<Window x:Class="TelegramWin.Views.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сообщения"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <ListBox x:Name="MessagesList"
                 Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Сообщения">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding AccessibleText}"/>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6">
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Meta}"
                                   Opacity="0.7"
                                   FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="10"
                BorderBrush="#CCC"
                BorderThickness="1"
                Visibility="{Binding IsComposerVisible, Converter={StaticResource BoolToVis}}">

            <StackPanel>
                <DockPanel Margin="0,0,0,6"
                           Visibility="{Binding IsReplyMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ReplyAutomationName}"
                               Margin="0,0,8,0"/>
                    <Button Content="Отменить"
                            Click="CancelReply_Click"/>
                </DockPanel>

                <TextBox x:Name="ComposerBox"
                         Text="{Binding ComposerText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         PreviewKeyDown="ComposerBox_PreviewKeyDown"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>