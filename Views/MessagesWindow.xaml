<Window x:Class="TelegramWin.Views.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Сообщения"
        Height="700" Width="520"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#FF0B0B0B"
        Foreground="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Оформление элементов списка сообщений -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#FF111111"/>
            <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- JAWS будет читать это -->
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF1B1B1B"/>
                    <Setter Property="BorderBrush" Value="#FF6A5ACD"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Нижняя панель: кнопки + редактор -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#FF2A2A2A"
                BorderThickness="1"
                Padding="8"
                Margin="0,8,0,0"
                Background="#FF0F0F0F">
            <StackPanel>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="ReplyButton"
                            Content="Ответить"
                            MinWidth="110"
                            Margin="0,0,8,0"
                            Click="ReplyButton_Click"/>
                    <Button x:Name="WriteButton"
                            Content="Написать"
                            MinWidth="110"
                            Click="WriteButton_Click"/>
                </StackPanel>

                <!-- Редактор -->
                <Border Visibility="{Binding IsComposerVisible, Converter={StaticResource BoolToVis}}"
                        BorderBrush="#FF6A5ACD"
                        BorderThickness="1"
                        Padding="8"
                        Background="#FF0B0B0B">
                    <StackPanel>

                        <!-- Плашка ответа -->
                        <DockPanel Margin="0,0,0,6"
                                   Visibility="{Binding IsReplyMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Ответ на:"
                                       FontWeight="Bold"
                                       Margin="0,0,6,0"
                                       DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding ReplyPreviewText}"
                                       TextWrapping="Wrap"
                                       DockPanel.Dock="Left"/>
                            <Button Content="Отменить"
                                    Margin="10,0,0,0"
                                    DockPanel.Dock="Right"
                                    Click="CancelReply_Click"/>
                        </DockPanel>

                        <TextBox x:Name="ComposerBox"
                                 MinHeight="70"
                                 Text="{Binding ComposerText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="ComposerBox_PreviewKeyDown"
                                 Background="#FF111111"
                                 Foreground="White"
                                 BorderBrush="#FF2A2A2A"
                                 BorderThickness="1"
                                 AutomationProperties.Name="{Binding ComposerAutomationName}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SendButton"
                                    Content="Отправить"
                                    MinWidth="110"
                                    Click="SendButton_Click"/>
                            <TextBlock Margin="10,4,0,0"
                                       Foreground="#FFB8B8B8"
                                       Text="Enter — отправить, Shift+Enter — новая строка, Esc — закрыть окно сообщений"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Список сообщений -->
        <ListBox x:Name="MessagesList"
                 ItemsSource="{Binding Messages}"
                 SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                 Background="#FF0B0B0B"
                 BorderBrush="#FF2A2A2A"
                 BorderThickness="1"
                 AutomationProperties.Name="Список сообщений">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding Meta}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#FFB8B8B8"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>