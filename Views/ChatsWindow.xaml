<Window x:Class="TelegramWin.Views.ChatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TelegramWin — Чаты" Height="520" Width="720"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <TextBlock x:Name="LiveStatus"
                   Opacity="0.01"
                   Height="1"
                   Focusable="False"
                   IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="" />
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Чаты" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusTextBlock" Text="{Binding Status}" Margin="0,6,0,0"/>
        </StackPanel>

        <ListBox x:Name="ChatsList"
                 Grid.Row="1"
                 ItemsSource="{Binding Chats}"
                 DisplayMemberPath="AccessibleText"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 AutomationProperties.Name="Список чатов"
                 KeyDown="ChatsList_KeyDown"
                 MouseDoubleClick="ChatsList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Window>