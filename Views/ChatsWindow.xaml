<Window x:Class="TelegramWin.Views.ChatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TelegramWin — Чаты" Height="520" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Чаты" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0"
                       AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>

        <ListBox x:Name="ChatsList"
                 Grid.Row="1"
                 ItemsSource="{Binding Chats}"
                 DisplayMemberPath="AccessibleText"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 AutomationProperties.Name="Список чатов">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Window>
